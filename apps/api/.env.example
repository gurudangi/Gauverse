# Copy this file to .env and fill in your values:
#   Windows:  Copy-Item apps\api\.env.example apps\api\.env
#   Mac/Linux: cp apps/api/.env.example apps/api/.env
#
# MongoDB Atlas is optional for local development.
# If MONGODB_URI is missing or unreachable, the API starts an in-memory MongoDB
# and seeds sample products automatically.

MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@your-cluster.mongodb.net
MONGODB_DB_NAME=gauverse
PORT=3000

# Auth (change secrets in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=admin@gauverse.local
SUPER_ADMIN_PASSWORD=ChangeMe@12345
SUPER_ADMIN_NAME=Super Admin
FARM_STAFF_EMAIL=farm@gauverse.local
FARM_STAFF_PASSWORD=ChangeMe@12345
FARM_STAFF_NAME=Farm Staff
INVENTORY_EMAIL=inventory@gauverse.local
INVENTORY_PASSWORD=ChangeMe@12345
INVENTORY_NAME=Inventory Manager

# Razorpay (set RAZORPAY_MOCK=true for local checkout without real keys)
RAZORPAY_MOCK=true
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_COMPANY_NAME=Shri Ahilyamata Gaushala

# Optional comma-separated browser origins (Vite ports 5180–5185 are allowed by default)
# CORS_ORIGINS=http://localhost:5180,http://localhost:5173
